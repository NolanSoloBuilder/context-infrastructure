.000Z"}],"gauges":[{"key":"turnover","display":"3%","caption":"成交 1.48 万亿 · 近 250 日","score":3,"asOf":"2026-11-16"}],"events":[{"at":"2026-11-17T13:30:00.000Z","allDay":false,"title":"美国零售销售","kind":"data","impact":"high","region":"us","detail":"环比 预期 0.2%，前值 0.8%；核心环比 预期 0.4%，前值 0.9%"},{"at":"2026-11-18T07:02:00.000Z","allDay":false,"title":"实际使用外资","kind":"data","impact":"low","region":"cn","detail":"前值 -4.3%"},{"at":"2026-11-18T19:00:00.000Z","allDay":false,"title":"FOMC 会议纪要","kind":"meeting","impact":"high","region":"us","detail":""},{"at":"2026-11-20T01:00:00.000Z","allDay":false,"title":"1 年期 LPR","kind":"meeting","impact":"medium","region":"cn","detail":"预期 3.00%，前值 3.00%"},{"at":"2026-11-20T01:00:00.000Z","allDay":false,"title":"5 年期 LPR","kind":"meeting","impact":"medium","region":"cn","detail":"预期 3.50%，前值 3.50%"}],"summary_md":"- 截至收盘，上证指数报3602.57点跌0.87%，深证成指跌2.53%，创业板指跌4.37%，科创50跌5.16%，沪深两市成交额约1.48万亿元，市场整体下跌家数明显多于上涨家数，全市场超250股跌超9%。\n- 盘面上，资金继续偏向红利与大市值方向，银行、消费龙头相对抗跌，贵州茅台、工商银行、中国移动等个股逆势上涨；成长风格承压更重，创业板和科创板跌幅居前。\n- 受汽车产业链账期治理消息影响，汽车产业链相关政策关注度提升；工信部表示，将对供应商账款支付规模大、故意拉长账期或投诉较多的车企联合相关部门开展约谈并督促整改。\n- 制造业与地方产业政策方面，商务部提到推动部分制造业项目在中部地区梯次转移和落地承接；国家发改委批复新建南阳至信阳至合肥铁路可研，利于中部地区基础设施补强。\n- 个股层面，回购与并购重组消息较多，青鸟智控、锦浪科技、赛伍技术、金房能源、华兴源创等披露回购计划；中国稀土拟收购中稀凉山51%股权，瑞晟智能拟定增募资投建智能物流搬运机器人项目。\n- 港股与外盘方面，恒生指数收涨0.49%，恒生科技指数微跌0.3%，纳斯达克中国金龙指数上涨0.84%；美股标普500上周五跌0.4%，AI与芯片链波动仍在，可能继续影响A股科技情绪。\n- 后续需关注美国零售销售、FOMC会议纪要以及国内1年期和5年期LPR等事件；贵金属价格回落、离岸人民币汇率波动及全球AI产业链情绪变化，也可能继续扰动市场。","sources":["东方财富","新浪财经","Google 新闻"],"updated_at":"2026-11-16 09:33:16"}