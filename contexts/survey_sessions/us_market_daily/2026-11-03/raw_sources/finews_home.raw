  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    /* Georgia 的数字是老式数字（3、5、7、9 沉到基线下），夹在中文里高低参差；
       这里只把数字、小数点、百分号、正负号映射到 Times New Roman 的等高数字，其它字符不受影响。 */
    @font-face {
      font-family: "Lining Digits";
      src: local("Times New Roman"), local("TimesNewRomanPSMT");
      unicode-range: U+0030-0039, U+002B-002E, U+0025;
    }
    :root {
      color-scheme: light;
      --bg: #ede8dc;
      --panel: #fffdf6;
      --ink: #111111;
      --muted: #5c5a55;
      --line: #171717;
      --soft-line: #cfc7b8;
      --hairline: #e2dbcf;
      --paper: #fbf7ec;
      --up: #176b43;
      --down: #9f1d20;
      --good: #176b43;
      --bad: #9f1d20;
      --accent: #111111;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background:
        radial-gradient(circle at 1px 1px, rgba(17, 17, 17, 0.045) 1px, transparent 0) 0 0 / 10px 10px,
        linear-gradient(90deg, rgba(255,255,255,0.34), rgba(0,0,0,0.025)),
        var(--bg);
      color: var(--ink);
      font-family: "Lining Digits", Georgia, "Times New Roman", "Noto Serif SC", "Songti SC", serif;
      line-height: 1.58;
    }
    header {
      background:
        linear-gradient(rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0.08)),
        var(--paper);
      border-bottom: 4px double var(--line);
    }
    .wrap {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }
    .topbar {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
      justify-content: space-between;
      min-height: 60px;
      padding: 10px 0;
    }
    .topbar-rule {
      background: var(--line);
      flex: 1 1 40px;
      height: 1px;
      min-width: 24px;
    }
    .brand {
      align-items: center;
      color: inherit;
      display: inline-flex;
      flex-shrink: 0;
      font-size: 32px;
      font-weight: 900;
      gap: 10px;
      letter-spacing: 0;
      line-height: 1;
      text-decoration: none;
    }
    .brand-logo {
      display: block;
      height: 36px;
      width: 36px;
    }
    .brand-word {
      display: inline-block;
    }
    .topbar-right {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      justify-content: flex-end;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    /* 日期选择器右侧的一组方形图标按钮，和选择器等高（32px），贴近它形成一组控件；
       选择器是实心黑，这里用描边，悬停时反相成实心。 */
    .topbar-links {
      display: flex;
      gap: 6px;
      margin-left: -10px;
    }
    .topbar-link {
      align-items: center;
      border: 1px solid var(--line);
      color: var(--ink);
      display: inline-flex;
      height: 32px;
      justify-content: center;
      width: 32px;
    }
    .topbar-link:hover,
    .topbar-link:focus-visible {
      background: var(--ink);
      color: var(--panel);
    }
    .topbar-icon {
      display: block;
    }
    .date {
      color: var(--ink);
      font-size: 11px;
      font-weight: 650;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .date-picker {
      position: relative;
    }
    .date-trigger {
      align-items: center;
      background: var(--ink);
      border: 1px solid var(--ink);
      color: var(--panel);
      cursor: pointer;
      display: inline-flex;
      font: inherit;
      font-size: 13px;
      font-variant-numeric: tabular-nums;
      font-weight: 650;
      gap: 10px;
      height: 32px;
      justify-content: space-between;
      letter-spacing: 0.02em;
      min-width: 130px;
      padding: 0 12px;
    }
    .date-trigger:disabled {
      background: var(--panel);
      border-color: var(--soft-line);
      color: var(--muted);
      cursor: default;
    }
    .date-trigger:disabled .chevron {
      border-color: var(--muted);
    }
    .chevron {
      border-bottom: 1px solid currentColor;
      border-right: 1px solid currentColor;
      display: inline-block;
      height: 6px;
      transform: rotate(45deg) translateY(-2px);
      width: 6px;
    }
    .calendar-panel {
      background: var(--panel);
      border: 1px solid var(--line);
      box-shadow: 0 18px 38px rgba(17, 17, 17, 0.16);
      display: none;
      min-width: 292px;
      padding: 12px;
      position: absolute;
      right: 0;
      top: calc(100% + 6px);
      z-index: 10;
    }
    .date-picker.open .calendar-panel {
      display: grid;
      gap: 10px;
    }
    .calendar-head {
      align-items: center;
      display: flex;
      justify-content: space-between;
    }
    .calendar-month {
      color: var(--ink);
      font-family: "Lining Digits", Georgia, "Times New Roman", "Noto Serif SC", "Songti SC", serif;
      font-size: 18px;
      font-weight: 800;
      line-height: 1;
    }
    .calendar-nav {
      align-items: center;
      background: transparent;
      border: 1px solid var(--line);
      color: var(--ink);
      cursor: pointer;
      display: inline-flex;
      font: inherit;
      font-size: 14px;
      font-weight: 750;
      height: 28px;
      justify-content: center;
      line-height: 1;
      margin-left: 4px;
      padding: 0 9px;
    }
    .calendar-nav:disabled {
      border-color: var(--hairline);
      color: #aaa39a;
      cursor: default;
    }
    .calendar-weekdays,
    .calendar-grid {
      display: grid;
      gap: 4px;
      grid-template-columns: repeat(7, 1fr);
    }
    .calendar-weekday {
      color: var(--muted);
      font-size: 11px;
      font-weight: 750;
      letter-spacing: 0.04em;
      text-align: center;
    }
    .calendar-day {
      align-items: center;
      aspect-ratio: 1;
      background: transparent;
      border: 1px solid transparent;
      color: #aaa39a;
      display: flex;
      font: inherit;
      font-size: 13px;
      justify-content: center;
      min-width: 0;
      text-decoration: none;
    }
    .calendar-day.available {
      border-color: var(--soft-line);
      color: var(--ink);
    }
    .calendar-day.available:hover,
    .calendar-day.available:focus {
      background: #f0eee6;
      outline: none;
    }
    .calendar-day.current {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--panel);
    }
    main {
      background:
        linear-gradient(rgba(255, 253, 246, 0.90), rgba(255, 253, 246, 0.90)),
        var(--paper);
      box-shadow: 0 18px 50px rgba(49, 42, 31, 0.14);
      margin: 18px auto 44px;
      padding: 20px 22px 34px;
    }
    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 326px;
      gap: 22px;
      align-items: start;
    }
    .main-column {
      min-width: 0;
    }
    section, aside {
      background: transparent;
      border: 0;
      border-radius: 0;
    }
    .block {
      padding: 0;
    }
    h1, h2 {
      margin: 0;
      letter-spacing: 0;
    }
    .report-title {
      font-size: 28px;
      font-weight: 900;
      letter-spacing: 0.01em;
      line-height: 1.15;
      margin: 0 0 14px;
    }
    .section-heading {
      border-bottom: 3px double var(--line);
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 0.02em;
      line-height: 1.05;
      margin-bottom: 7px;
      padding-bottom: 8px;
      white-space: nowrap;
    }
    .heatmap-section {
      margin-bottom: 18px;
    }
    .heatmap-link {
      display: block;
      line-height: 0;
      border: 1px solid var(--line);
      background: var(--paper);
    }
    .heatmap-link svg {
      display: block;
      width: 100%;
      height: auto;
    }
    .events-section {
      border-top: 1px solid var(--line);
      margin-top: 16px;
      padding-top: 12px;
    }
    .events {
      border-bottom: 1px solid var(--line);
      padding-bottom: 2px;
    }
    .event-row {
      align-items: baseline;
      display: grid;
      gap: 10px;
      grid-template-columns: 66px 42px minmax(0, 1fr) 9px;
      padding: 4px 0;
    }
    .event-row-newday {
      border-top: 1px solid var(--hairline);
      margin-top: 3px;
      padding-top: 7px;
    }
    .event-day,
    .event-time {
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .event-day {
      font-size: 11px;
      font-weight: 750;
      letter-spacing: 0.06em;
    }
    .event-time {
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
    }
    .event-main {
      align-items: baseline;
      column-gap: 10px;
      display: flex;
      flex-wrap: wrap;
      min-width: 0;
      row-gap: 1px;
    }
    .event-title {
      font-size: 15px;
      line-height: 1.35;
    }
    .event-row[data-impact="high"] .event-title {
      font-weight: 800;
    }
    .event-row[data-kind="speech"] .event-title::before {
      content: "讲话";
      background: var(--ink);
      color: var(--panel);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1;
      margin-right: 6px;
      padding: 2px 4px;
      position: relative;
      top: -2px;
    }
    .event-detail {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 11.5px;
      line-height: 1.4;
    }
    .event-impact {
      border: 1.5px solid var(--down);
      border-radius: 50%;
      display: inline-block;
      height: 8px;
      position: relative;
      top: -1px;
      width: 8px;
    }
    .event-row[data-impact="high"] .event-impact {
      background: var(--down);
    }
    .summary {
      display: grid;
      gap: 0;
      margin-top: 0;
      border-bottom: 1px solid var(--line);
    }
    .summary-item {
      border-bottom: 1px solid var(--hairline);
      display: grid;
      gap: 12px;
      grid-template-columns: 30px minmax(0, 1fr);
      padding: 10px 0;
    }
    .summary-item:last-child { border-bottom: 0; }
    .summary-number {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 11px;
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      padding-top: 4px;
    }
    .summary-text {
      font-size: 17px;
      line-height: 1.56;
    }
    .rail {
      border-left: 3px double var(--line);
      padding-left: 16px;
    }
    .indices {
      display: grid;
      gap: 0;
    }
    .market-group + .market-group {
      margin-top: 20px;
    }
    .rail-feature {
      display: block;
      width: 100%;
      max-width: 600px;
      box-sizing: border-box;
      padding: 6px;
      background: var(--panel);
      border: 1px solid var(--line);
      color: inherit;
      text-decoration: none;
      overflow: hidden;
      position: relative;
    }
    /* 赞助素材右上角的「赞助」标注；类名避开 ad / sponsor / badge 等字眼，免得被广告拦截插件隐藏。 */
    .rail-feature-note {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 1px 6px;
      background: rgba(0, 0, 0, 0.55);
      color: #fff;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 11px;
      line-height: 16px;
      letter-spacing: 0.08em;
      pointer-events: none;
    }
    /* 素材按 2:1 自适应宽度，容器高度跟随；不要在容器上定比例，
       否则内边距和边框会让内容区偏离 2:1，素材被 cover 裁边。 */
    .rail-feature img,
    .rail-feature video {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 1;
      object-fit: cover;
    }
    .rail-feature-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      height: 100%;
      box-sizing: border-box;
      padding: 10px;
      border: 1px dashed var(--soft-line);
      text-align: center;
    }
    .rail-feature-kicker {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
    }
    .rail-feature-cta {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 12px;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .rail-feature:hover .rail-feature-card { border-color: var(--line); }
    .rail-feature:hover .rail-feature-cta { color: var(--ink); }
    .rail-feature-group + .rail-feature-group {
      margin-top: 10px;
    }
    .rail-feature-contact {
      margin-top: 8px;
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 12px;
      text-align: right;
    }
    .rail-feature-contact a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .rail-feature-contact a:hover { color: var(--ink); }
    .sister-site {
      align-items: center;
      display: flex;
      gap: 12px;
      padding: 10px 12px;
    }
    .rail-feature .sister-logo {
      display: block;
      flex-shrink: 0;
      height: 40px;
      object-fit: contain;
      width: 40px;
    }
    .rail-feature .sister-logo svg {
      display: block;
      height: 100%;
      width: 100%;
    }
    .sister-body {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .sister-name {
      font-size: 17px;
      font-weight: 900;
      letter-spacing: 0.02em;
      line-height: 1.15;
    }
    .sister-tagline {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 12px;
      line-height: 1.4;
    }
    /* 箭头用内联 SVG 描边绘制：以前用伪元素拼（横杆 + 旋转方块的两条边），
       杆会穿过箭头的 V 形顶点、尖角是斜接的方角，在不同 DPR 下粗细不一，看着别扭。 */
    .sister-arrow {
      color: var(--muted);
      display: block;
      flex-shrink: 0;
      height: 14px;
      margin-left: auto;
      margin-right: 2px;
      width: 18px;
    }
    .sister-site:hover .sister-arrow,
    .sister-site:hover .sister-tagline { color: var(--ink); }
    .subscribe-copy {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
      margin: 4px 0 10px;
    }
    .subscribe-form {
      display: flex;
      gap: 6px;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .subscribe-input {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 0;
      color: var(--ink);
      flex: 1 1 auto;
      font: inherit;
      font-size: 14px;
      height: 36px;
      min-width: 0;
      padding: 0 10px;
    }
    .subscribe-input:focus {
      outline: 2px solid var(--line);
      outline-offset: -1px;
    }
    .subscribe-button {
      background: var(--ink);
      border: 1px solid var(--line);
      border-radius: 0;
      color: var(--panel);
      cursor: pointer;
      flex: 0 0 auto;
      font: inherit;
      font-size: 14px;
      font-weight: 700;
      height: 36px;
      padding: 0 16px;
    }
    .subscribe-button:hover { background: var(--panel); color: var(--ink); }
    .subscribe-button:disabled { cursor: default; opacity: 0.6; }
    .subscribe-status {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 12px;
      line-height: 1.5;
      margin: 6px 0 0;
      min-height: 0;
    }
    .subscribe-status:empty { display: none; }
    .subscribe-status.ok { color: var(--good); }
    .subscribe-status.error { color: var(--bad); }
    .gauges {
      display: grid;
      gap: 0;
    }
    .gauge {
      border-bottom: 1px solid var(--hairline);
      padding: 10px 0;
    }
    .gauge:last-child {
      border-bottom: 0;
    }
    .gauge-head {
      align-items: center;
      display: flex;
      gap: 8px;
      justify-content: space-between;
    }
    .gauge-label {
      font-size: 15px;
      font-weight: 750;
    }
    .gauge-info {
      align-items: center;
      background: transparent;
      border: 0;
      color: var(--muted);
      cursor: pointer;
      display: inline-flex;
      height: 22px;
      justify-content: center;
      padding: 0;
      width: 22px;
    }
    .gauge-info:hover,
    .gauge-info:focus-visible {
      color: var(--ink);
      outline: none;
    }
    .gauge-value {
      align-items: baseline;
      display: flex;
      flex-wrap: wrap;
      gap: 4px 8px;
      margin-top: 4px;
    }
    .gauge-display {
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 19px;
      font-variant-numeric: tabular-nums;
      font-weight: 800;
      line-height: 1.1;
    }
    .gauge-caption {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 11px;
    }
    .gauge-bar {
      background: var(--hairline);
      height: 4px;
      margin-top: 8px;
      overflow: hidden;
    }
    .gauge-bar > span {
      background: var(--muted);
      display: block;
      height: 100%;
    }
    .gauge[data-sentiment="good"] .gauge-display { color: var(--good); }
    .gauge[data-sentiment="good"] .gauge-bar > span { background: var(--good); }
    .gauge[data-sentiment="neutral"] .gauge-display { color: #9a6b00; }
    .gauge[data-sentiment="neutral"] .gauge-bar > span { background: #9a6b00; }
    .gauge[data-sentiment="bad"] .gauge-display { color: var(--bad); }
    .gauge[data-sentiment="bad"] .gauge-bar > span { background: var(--bad); }
    .gauge-method {
      border-left: 2px solid var(--soft-line);
      color: var(--muted);
      font-size: 12.5px;
      line-height: 1.55;
      margin-top: 9px;
      padding-left: 10px;
    }
    .index-row,
    .stock-row,
    .treasury-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
      padding: 8px 0;
      border-bottom: 1px solid var(--hairline);
    }
    .index-row:last-child,
    .stock-row:last-child,
    .treasury-row:last-child { border-bottom: 0; }
    .index-name,
    .stock-name,
    .treasury-name {
      font-size: 15px;
      font-weight: 750;
      overflow-wrap: anywhere;
    }
    .stock-name,
    .treasury-name {
      font-size: 14px;
    }
    .index-symbol,
    .stock-symbol,
    .treasury-symbol,
    .quote-link {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 11px;
      margin-top: 2px;
    }
    .quote-link {
      display: inline-block;
      text-decoration: none;
    }
    .quote-link:hover {
      text-decoration: underline;
    }
    .index-value,
    .stock-value,
    .treasury-value {
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 13px;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .move {
      display: block;
      font-size: 12px;
      margin-top: 2px;
    }
    .move.up { color: var(--up); }
    .move.down { color: var(--down); }
    .news-section {
      border-top: 1px solid var(--line);
      margin-top: 16px;
      padding-top: 12px;
    }
    .news-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 20px;
      margin-top: 0;
      padding-top: 8px;
    }
    .news-item {
      break-inside: avoid;
      padding: 11px 0;
      border-bottom: 1px solid var(--hairline);
    }
    .news-item:first-child {
      border-bottom: 1px solid var(--line);
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .news-item:first-child .news-title {
      font-size: 24px;
      line-height: 1.12;
    }
    .news-item:first-child .news-summary {
      font-size: 15px;
      max-width: 760px;
    }
    .news-title {
      color: var(--accent);
      font-size: 18px;
      font-weight: 850;
      line-height: 1.18;
      text-decoration: none;
    }
    .news-title:hover { text-decoration: underline; }
    .news-meta {
      margin: 5px 0;
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 11px;
      font-weight: 650;
      letter-spacing: 0.02em;
    }
    .news-summary {
      margin: 0;
      color: #2d2d2d;
      font-size: 14px;
      line-height: 1.52;
    }
    .sources {
      color: var(--muted);
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 12px;
      margin-top: 8px;
    }
    .empty {
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      min-height: 360px;
      display: grid;
      place-items: center;
      text-align: center;
      color: var(--muted);
    }
    .empty h1 {
      border: 0;
      padding: 0;
    }
    @media (max-width: 860px) {
      .topbar {
        gap: 8px 12px;
        min-height: 52px;
        padding: 8px 0;
      }
      .brand {
        font-size: 24px;
        gap: 8px;
      }
      .brand-logo {
        height: 30px;
        width: 30px;
      }
      .topbar-rule {
        display: none;
      }
      .topbar-right {
        display: contents;
      }
      .grid {
        grid-template-columns: 1fr;
      }
      .rail {
        border-left: 0;
        border-top: 2px solid var(--line);
        padding-left: 0;
        padding-top: 18px;
      }
      .summary {
        margin-top: 4px;
      }
      .news-list {
        grid-template-columns: 1fr;
      }
      h1 {
        font-size: 26px;
      }
      .report-title {
        font-size: 24px;
      }
      .section-heading {
        font-size: 20px;
      }
      .date {
        align-self: stretch;
        border-top: 1px solid var(--hairline);
        /* 基准占满整行减去图标组（58px + 12px 列间距），保证换到第二行且图标同行。 */
        flex: 1 1 calc(100% - 72px);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        min-width: 0;
        order: 3;
        padding-top: 6px;
        white-space: normal;
      }
      .date-picker {
        margin-left: auto;
      }
      .date-trigger {
        min-width: 0;
      }
      /* topbar-right 在窄屏是 display: contents，图标组直接成为 topbar 的 flex 子项：
         和更新时间同在第二行、靠右，去掉描边只留字形。负 margin 补上列间距，
         让两者的 border-top 连成一条线。 */
      .topbar-links {
        align-items: center;
        align-self: stretch;
        border-top: 1px solid var(--hairline);
        gap: 2px;
        margin-left: -12px;
        order: 4;
        padding-left: 12px;
        padding-top: 6px;
      }
      .topbar-link {
        border: 0;
        color: var(--muted);
        height: 24px;
        margin: -3px 0; /* 点击区 24px，占位 18px，和更新时间的文字行对齐 */
        width: 28px;
      }
      .topbar-link:hover,
      .topbar-link:focus-visible {
        background: none;
        color: var(--ink);
      }
    }
    @media (max-width: 560px) {
      h1 {
        font-size: 20px;
      }
      .report-title {
        font-size: 21px;
      }
      .section-heading {
        font-size: 18px;
        white-space: normal;
      }
      .summary-item {
        grid-template-columns: 28px minmax(0, 1fr);
      }
      .event-row {
        gap: 8px;
        grid-template-columns: 58px 40px minmax(0, 1fr) 8px;
      }
      .event-title {
        font-size: 14px;
      }
      .summary-text {
        font-size: 16px;
      }
      .news-item:first-child {
        grid-column: auto;
      }
      .news-item:first-child .news-title {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap topbar">
      <a class="brand" href="/" aria-label="FiNews 首页">
        <img class="brand-logo" src="/logo.svg" alt="FiNews logo" width="36" height="36">
        <span class="brand-word">FiNews</span>
      </a>
      <span class="topbar-rule" aria-hidden="true"></span>
      <div class="topbar-right">
