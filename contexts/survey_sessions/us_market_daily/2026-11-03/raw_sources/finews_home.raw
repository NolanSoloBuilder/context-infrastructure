</div></main>
  <script>
    const picker = document.getElementById("date-picker");
    const trigger = document.getElementById("date-trigger");
    const panel = document.getElementById("calendar-panel");
    const grid = document.getElementById("calendar-grid");
    const monthLabel = document.getElementById("calendar-month");
    const prevButton = document.getElementById("calendar-prev");
    const nextButton = document.getElementById("calendar-next");
    const availableDates = ["2026-11-02","2026-10-30","2026-10-29","2026-10-28","2026-10-27","2026-10-26","2026-10-23","2026-10-22","2026-10-21","2026-10-20","2026-10-19","2026-10-16","2026-10-15","2026-10-14","2026-10-13","2026-10-12","2026-10-09","2026-10-08","2026-10-07","2026-10-06","2026-10-05","2026-10-02","2026-10-01","2026-09-30","2026-09-29","2026-09-28","2026-09-25","2026-09-24","2026-09-23","2026-09-22","2026-09-21","2026-09-18","2026-09-17","2026-09-16","2026-09-15","2026-09-14","2026-09-11","2026-09-10","2026-09-09","2026-09-08","2026-09-04","2026-09-03","2026-09-02","2026-09-01","2026-08-31","2026-08-28","2026-08-27","2026-08-26","2026-08-25","2026-08-24","2026-08-21","2026-08-20","2026-08-19","2026-08-18","2026-08-17","2026-08-14","2026-08-13","2026-08-12","2026-08-11","2026-08-10","2026-08-07","2026-08-06","2026-08-05","2026-08-04","2026-08-03","2026-07-31","2026-07-30","2026-07-29","2026-07-28","2026-07-27","2026-07-24","2026-07-23","2026-07-22","2026-07-21","2026-07-20","2026-07-17","2026-07-16","2026-07-15","2026-07-14","2026-07-13","2026-07-10","2026-07-09","2026-07-08","2026-07-07","2026-07-06","2026-07-02","2026-07-01","2026-06-30","2026-06-29","2026-06-26","2026-06-25","2026-06-24","2026-06-23","2026-06-22","2026-06-18","2026-06-17","2026-06-16","2026-06-15"];
    const activeDate = "2026-11-02";
    const availableSet = new Set(availableDates);
    const availableMonths = Array.from(new Set(availableDates.map((date) => date.slice(0, 7)))).sort();
    let visibleMonth = (activeDate || availableDates[0] || "").slice(0, 7);
    const closePicker = () => {
      picker?.classList.remove("open");
      trigger?.setAttribute("aria-expanded", "false");
    };
    trigger?.addEventListener("click", () => {
      const nextOpen = !picker?.classList.contains("open");
      picker?.classList.toggle("open", nextOpen);
      trigger.setAttribute("aria-expanded", String(nextOpen));
      if (nextOpen) renderCalendar();
    });
    document.addEventListener("click", (event) => {
      if (picker && !picker.contains(event.target)) closePicker();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePicker();
      if (event.key === "ArrowDown" && picker?.classList.contains("open")) {
        event.preventDefault();
        panel?.querySelector("a")?.focus();
      }
    });
    prevButton?.addEventListener("click", () => moveMonth(-1));
    nextButton?.addEventListener("click", () => moveMonth(1));

    function moveMonth(delta) {
      const index = availableMonths.indexOf(visibleMonth);
      const nextMonth = availableMonths[index + delta];
      if (!nextMonth) return;
      visibleMonth = nextMonth;
      renderCalendar();
    }

    function renderCalendar() {
      if (!grid || !monthLabel || !visibleMonth) return;
      const [year, month] = visibleMonth.split("-").map(Number);
      const firstDay = new Date(Date.UTC(year, month - 1, 1));
      const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
      const leadingDays = firstDay.getUTCDay();
      const monthIndex = availableMonths.indexOf(visibleMonth);
      monthLabel.textContent = year + " 年 " + month + " 月";
      if (prevButton) prevButton.disabled = monthIndex <= 0;
      if (nextButton) nextButton.disabled = monthIndex === -1 || monthIndex >= availableMonths.length - 1;
      const cells = [];
      for (let i = 0; i < leadingDays; i += 1) {
        cells.push('<span class="calendar-day" aria-hidden="true"></span>');
      }
      for (let day = 1; day <= daysInMonth; day += 1) {
        const date = year + "-" + String(month).padStart(2, "0") + "-" + String(day).padStart(2, "0");
        if (availableSet.has(date)) {
          const current = date === activeDate ? " current" : "";
          const ariaCurrent = date === activeDate ? ' aria-current="date"' : "";
          cells.push('<a class="calendar-day available' + current + '" href="/' + date + '"' + ariaCurrent + '>' + day + '</a>');
        } else {
          cells.push('<span class="calendar-day">' + day + '</span>');
        }
      }
      grid.innerHTML = cells.join("");
    }
    renderCalendar();

    document.querySelectorAll(".gauge-info").forEach((button) => {
      button.addEventListener("click", () => {
        const panel = document.getElementById(button.getAttribute("aria-controls"));
        if (!panel) return;
        const willOpen = panel.hasAttribute("hidden");
        if (willOpen) {
          panel.removeAttribute("hidden");
          trackEvent("gauge-method-open", { gauge: button.getAttribute("data-gauge") || "unknown" });
        } else {
          panel.setAttribute("hidden", "");
        }
        button.setAttribute("aria-expanded", String(willOpen));
      });
    });

    // Argos 自定义事件：日期切换、新闻外链、行情外链。
    // 用事件委托，因为日历格子会被 renderCalendar() 反复重建。
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const dateLink = target.closest("a.calendar-day.available");
      if (dateLink) {
        trackEvent("select-date", { current: dateLink.hasAttribute("aria-current") });
        return;
      }
      const newsLink = target.closest("a.news-title");
      if (newsLink) {
        trackEvent("news-click", { source: newsLink.getAttribute("data-source") || "unknown" });
        return;
      }
      const adLink = target.closest("a.rail-feature, a.topbar-link");
      if (adLink) {
        trackEvent("ad-click", { sponsor: adLink.getAttribute("data-sponsor") || "none" });
        return;
      }
      const quoteLink = target.closest("a.quote-link");
      if (quoteLink) {
        trackEvent("quote-click", {
          kind: quoteLink.getAttribute("data-kind") || "unknown",
          symbol: quoteLink.getAttribute("data-symbol") || "unknown"
        });
      }
    });

    // 邮件订阅：拦截表单提交改为 JSON 请求，把结果显示在表单下方；
    // 脚本不可用时表单会按普通 POST 提交，服务端返回 HTML 页面。
    const subscribeForm = document.getElementById("subscribe-form");
    if (subscribeForm) {
      const subscribeStatus = document.getElementById("subscribe-status");
      const subscribeButton = subscribeForm.querySelector("button");
      subscribeForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const email = subscribeForm.elements.email.value.trim();
        subscribeButton.disabled = true;
        subscribeStatus.className = "subscribe-status";
        subscribeStatus.textContent = "提交中…";
        try {
          const response = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "content-type": "application/json", accept: "application/json" },
            body: JSON.stringify({ email })
          });
          const data = await response.json().catch(() => ({}));
          subscribeStatus.textContent = data.message || (response.ok ? "已提交。" : "提交失败，请稍后再试。");
          subscribeStatus.classList.add(response.ok ? "ok" : "error");
          if (response.ok) {
            trackEvent("subscribe", { status: data.status || "unknown" });
            if (data.status === "pending") subscribeForm.reset();
          }
        } catch (_) {
          subscribeStatus.textContent = "网络错误，请稍后再试。";
          subscribeStatus.classList.add("error");
        } finally {
          subscribeButton.disabled = false;
        }
      });
    }

    const updatedEl = document.getElementById("updated-at");
    if (updatedEl) {
      const parsed = new Date(updatedEl.getAttribute("data-utc"));
      if (!isNaN(parsed.getTime())) {
        const pad = (n) => String(n).padStart(2, "0");
        updatedEl.textContent =
          parsed.getFullYear() + "-" + pad(parsed.getMonth() + 1) + "-" + pad(parsed.getDate()) +
          " " + pad(parsed.getHours()) + ":" + pad(parsed.getMinutes()) + ":" + pad(parsed.getSeconds());
      }
    }
  </script>
  <script>
    (function () {
      const modelContext = document.modelContext || navigator.modelContext;
      if (!modelContext) return;
      const fetchJson = async (path) => {
        const response = await fetch(path, { headers: { accept: "application/json" } });
        const data = await response.json();
        if (!response.ok) throw new Error(data && data.error ? data.error : "request_failed_" + response.status);
        return data;
      };
      const runTool = async (tool, args) => {
        if (typeof trackEvent === "function") trackEvent("webmcp-tool-call", { tool: tool.name });
        return tool.run(args);
      };
      const tools = [
        {
          name: "list_report_dates",
          description: "列出 FiNews 全部可用的美股盘后日报日期（美东交易日，YYYY-MM-DD，最新在前）。",
          inputSchema: { type: "object", properties: {} },
          async run() {
            return fetchJson("/api/reports/dates");
          }
        },
        {
          name: "get_latest_report",
          description: "获取最新一期美股盘后中文日报，包含主要指数、重点个股、国债收益率、汇率、市场情绪指标、要点总结和财经新闻列表。",
          inputSchema: { type: "object", properties: {} },
          async run() {
            return fetchJson("/api/reports/latest");
          }
        },
        {
          name: "get_report_by_date",
          description: "按日期获取某一期美股盘后中文日报；日期须是 list_report_dates 返回的交易日。",
          inputSchema: {
            type: "object",
            properties: {
              date: { type: "string", description: "报告日期，格式 YYYY-MM-DD" }
            },
            required: ["date"]
          },
          async run(args) {
            const date = args && args.date;
            if (!/^\d{4}-\d{2}-\d{2}$/.test(String(date || ""))) {
              throw new Error("date 必须是 YYYY-MM-DD 格式");
            }
            return fetchJson("/api/reports/" + date);
          }
        }
      ];
      if (typeof modelContext.registerTool === "function") {
        for (const tool of tools) {
          Promise.resolve(modelContext.registerTool({
            name: tool.name,
            description: tool.description,
            inputSchema: tool.inputSchema,
            execute: async (args) => JSON.stringify(await runTool(tool, args))
          })).catch((error) => console.warn("WebMCP registerTool failed:", tool.name, error));
        }
      } else if (typeof modelContext.provideContext === "function") {
        modelContext.provideContext({
          tools: tools.map((tool) => ({
            name: tool.name,
            description: tool.description,
            inputSchema: tool.inputSchema,
            execute: async (args) => ({
              content: [{ type: "text", text: JSON.stringify(await runTool(tool, args)) }]
            })
          }))
        });
      }
    })();
  </script>
</body>
</html>