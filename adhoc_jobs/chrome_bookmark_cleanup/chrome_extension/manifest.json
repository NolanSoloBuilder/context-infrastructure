{
  "manifest_version": 3,
  "name": "Codex Bookmark Organizer",
  "version": "1.0.0",
  "description": "One-shot local bookmark organizer generated by Codex.",
  "permissions": ["bookmarks", "storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["trigger.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
