# Optional. Without this key the pipeline still crawls official public websites.
HUNTER_API_KEY=

# Identify the crawler to website operators. Set this to a monitored address or URL.
BOT_CONTACT=https://example.com/contact

# Safety budgets. CLI flags override these values.
MAX_TARGETS=100
MAX_PAGES_PER_DOMAIN=12
MAX_RUNTIME_SECONDS=900
MAX_API_CALLS=100
REQUEST_DELAY_MS=2000
REFRESH_AFTER_DAYS=30
PROVIDER_CACHE_DAYS=30
VERIFICATION_CACHE_DAYS=7
