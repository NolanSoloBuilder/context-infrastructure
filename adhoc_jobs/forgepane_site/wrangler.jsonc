{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forgepane-site",
  "main": "src/index.js",
  "compatibility_date": "2026-06-19",
  "workers_dev": false,
  "assets": {
    "directory": "../xuhao_personal_site/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "forgepane.com/*",
      "zone_name": "forgepane.com"
    },
    {
      "pattern": "www.forgepane.com/*",
      "zone_name": "forgepane.com"
    },
    {
      "pattern": "nalon.forgepane.com",
      "custom_domain": true
    }
  ]
}
